<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cxdproject.coder.mapper.MeetingMapper">

    <resultMap id="BaseResultMap" type="cn.cxdproject.coder.model.entity.Meeting">
        <id column="id" property="id"/>
        <result column="meeting_number" property="meetingNumber"/>
        <result column="host_user_id" property="hostUserId"/>
        <result column="room_type" property="type"/>
        <result column="password" property="password"/>
        <result column="join_link" property="joinLink"/>
        <result column="status" property="status"/>
        <result column="max_participant_count" property="maxParticipants"/>
        <result column="scheduled_start_time" property="scheduledStartTime"/>
        <result column="start_time" property="actualStartTime"/>
        <result column="end_time" property="actualEndTime"/>
        <result column="mute_on_entry" property="muteOnEntry"/>
        <result column="allow_screen_share" property="allowScreenShare"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByMeetingNumber" resultMap="BaseResultMap">
        SELECT * FROM meeting_room
        WHERE meeting_number = #{meetingNumber}
        AND deleted = 0
        LIMIT 1
    </select>

    <select id="findByHostUserId" resultMap="BaseResultMap">
        SELECT * FROM meeting_room
        WHERE host_user_id = #{userId}
        AND deleted = 0
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="findByParticipantUserId" resultMap="BaseResultMap">
        SELECT m.* FROM meeting_room m
        INNER JOIN meeting_participant mp ON m.id = mp.room_id
        WHERE mp.user_id = #{userId}
        AND m.deleted = 0
        AND mp.deleted = 0
        <if test="status != null and status != ''">
            AND m.status = #{status}
        </if>
        ORDER BY m.created_at DESC
    </select>

</mapper>
