<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cxdproject.coder.mapper.MeetingParticipantMapper">

    <resultMap id="BaseResultMap" type="cn.cxdproject.coder.model.entity.MeetingParticipant">
        <id column="id" property="id"/>
        <result column="room_id" property="roomId"/>
        <result column="user_id" property="userId"/>
        <result column="display_name" property="displayName"/>
        <result column="role_type" property="roleType"/>
        <result column="join_source" property="joinSource"/>
        <result column="join_status" property="joinStatus"/>
        <result column="join_time" property="joinTime"/>
        <result column="leave_time" property="leaveTime"/>
        <result column="leave_reason" property="leaveReason"/>
        <result column="is_microphone_on" property="isMicrophoneOn"/>
        <result column="is_camera_on" property="isCameraOn"/>
        <result column="is_screen_sharing" property="isScreenSharing"/>
        <result column="is_hand_raised" property="isHandRaised"/>
        <result column="network_quality" property="networkQuality"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="findByMeetingId" resultMap="BaseResultMap">
        SELECT * FROM meeting_participant
        WHERE room_id = #{meetingId}
        AND deleted = 0
        ORDER BY join_time ASC
    </select>

    <select id="findByMeetingIdAndStatus" resultMap="BaseResultMap">
        SELECT * FROM meeting_participant
        WHERE room_id = #{meetingId}
        AND join_status = #{status}
        AND deleted = 0
        ORDER BY join_time ASC
    </select>

    <select id="findByMeetingIdAndUserId" resultMap="BaseResultMap">
        SELECT * FROM meeting_participant
        WHERE room_id = #{meetingId}
        AND user_id = #{userId}
        AND deleted = 0
        LIMIT 1
    </select>

    <select id="countByMeetingIdAndStatus" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM meeting_participant
        WHERE room_id = #{meetingId}
        AND join_status = #{status}
        AND deleted = 0
    </select>

</mapper>
